# For local development, copy this file to server/.env and replace the placeholder.
# For production, set these as backend secrets (never use a NEXT_PUBLIC_ prefix).
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=replace-with-your-mongodb-connection-string
SESSION_SECRET=replace-with-a-long-random-secret
LONGCAT_API_KEY=replace-with-your-longcat-api-key
LONGCAT_MODEL=LongCat-2.5
